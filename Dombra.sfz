// Dombra Studio - Kazakh dombra, single notes. Keys F3-G4 alternate between the two strings.
// A=440, tuning baked into the samples. Velocity sets the volume only.
<control> default_path=Samples/

<global> ampeg_attack=0.001 ampeg_release=0.8 amp_veltrack=70 volume=-3 pitch_random=5 amp_random=0.6

<region> sample=u0.wav lokey=45 hikey=48 pitch_keycenter=48 volume=0.0
